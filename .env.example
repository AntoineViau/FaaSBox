# Required for superuser creation
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=changeme

# Required. The database is encrypted at rest — function code, triggers, logs and
# secrets — so the server refuses to start without this key, and losing it makes
# an existing database unreadable for good. Generate with: openssl rand -hex 32
FAASBOX_ENCRYPTION_KEY=

# Optional: the address this instance answers on, as an origin and nothing else.
# It is what the OAuth authorization server publishes as its issuer, so it has no
# default: absent or invalid, the OAuth routes are not mounted and an agent
# connects with an API key as before. http:// is accepted on a loopback host only.
FAASBOX_PUBLIC_URL=https://faasbox.example.com

# Optional: max concurrent function executions (default: 4)
FAASBOX_MAX_CONCURRENCY=4

# Optional: bytes captured per output stream, stdout and stderr alike (default: 1048576)
# Beyond it the output is cut; a JSON result cut mid-document is refused with a 502.
# The bound is per stream, so the worst case of one invocation is twice this value.
FAASBOX_MAX_OUTPUT_SIZE=1048576

# Optional: bytes accepted in a request body (default: 1048576)
# Beyond it the request is refused with a 413.
FAASBOX_MAX_BODY_SIZE=1048576

# Optional: bytes of stdout and stderr kept in each log record (default: 8192)
# Only the stored copy is trimmed; the HTTP response carries the full output.
FAASBOX_MAX_LOG_OUTPUT=8192

# Optional: bytes of requestPayload kept in each log record (default: 4096)
FAASBOX_MAX_LOG_PAYLOAD=4096

# Optional: how many execution log records to keep (default: 1000)
# An hourly internal cron deletes the oldest beyond this count.
FAASBOX_MAX_LOG_RETENTION=1000

# Optional: bytes a file may hold and still be shown in the Files tab (default: 262144)
# Display only: past it the file is not rendered, and its download still works whole.
FAASBOX_MAX_FILE_VIEW=262144

# Optional: Litestream replication to S3 (for ephemeral containers)
# If not set, Litestream is disabled and data stays local only.
LITESTREAM_REPLICA_ENDPOINT=s3.amazonaws.com
LITESTREAM_REPLICA_BUCKET=my-faasbox-backup
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
